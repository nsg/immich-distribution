#!/bin/bash

. $SNAP/bin/load-env

export PGDATA="$SNAP_COMMON/pgsql/data"

if [ -z $DB_PASSWORD ]; then
    echo "NOTE: DB_PASSWORD not set, server will not be started"
    sleep 2
    exit 1
fi

if [ ! -e "$PGDATA" ]; then
    # This is a new install, configure
    echo $DB_PASSWORD > /tmp/pwfile
    drop_privileges $SNAP/usr/local/pgsql/bin/initdb --auth-host=md5 --username postgres --pwfile=/tmp/pwfile
    rm /tmp/pwfile
fi

drop_privileges $SNAP/bin/postgres-configure

(
    while ! $SNAP/usr/local/pgsql/bin/pg_isready; do
        sleep 1
    done
    
    drop_privileges $SNAP/usr/local/pgsql/bin/createdb --username=postgres immich

    # Empty schema left behind by the pgvecto.rs to VectorChord migration (#327)
    drop_privileges $SNAP/usr/local/pgsql/bin/psql --username=postgres -d immich \
        -c "DROP SCHEMA IF EXISTS vectors;"

    # Custom tables and trigger left behind by the removed legacy sync service
    drop_privileges $SNAP/usr/local/pgsql/bin/psql --username=postgres -d immich \
        -c "DROP TRIGGER IF EXISTS trigger_assets_delete_audits ON asset;" \
        -c "DROP FUNCTION IF EXISTS log_assets_delete_audits;" \
        -c "DROP TABLE IF EXISTS assets_delete_audits;" \
        -c "DROP TABLE IF EXISTS assets_filesync_lookup;"

) &

drop_privileges $SNAP/usr/local/pgsql/bin/postgres
